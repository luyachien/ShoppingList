# 複製本檔為 .env.local 後填入真實值。.env.local 不會進入 Git。
# 線上環境請在 Vercel Dashboard > Settings > Environment Variables 設定。

# Notion Internal Integration Token（Notion > 設定 > 連結 > 開發或管理整合）
NOTION_TOKEN=

# 「轉換紀錄」Database ID
NOTION_REGISTRY_DATABASE_ID=

# 轉換器管理密碼（只有擁有者知道）
ADMIN_PASSWORD=

# cookie 簽章用隨機字串，可用：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
